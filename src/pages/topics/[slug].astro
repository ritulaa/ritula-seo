---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const all = await getCollection('topics');
  const topicPages = all.filter((entry) => entry.data.type === 'topic');
  return topicPages.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, metaDescription, h1, intro, corpusLines, howToUse, relatedSlugs, band } = entry.data;

const all = await getCollection('topics');
function hrefFor(slug: string) {
  const target = all.find((e) => e.data.slug === slug);
  const base = target?.data.type === 'transition' ? '/roadmap/' : '/topics/';
  return `${base}${slug}`;
}
---
<Layout title={title} description={metaDescription}>
  {band && <span class="badge">{band}</span>}
  <h1>{h1}</h1>
  <p class="intro">{intro}</p>

  {corpusLines && corpusLines.length > 0 && (
    <div class="card">
      <ul class="lines">
        {corpusLines.map((line: string) => <li>{line}</li>)}
      </ul>
    </div>
  )}

  {howToUse && (
    <div class="card">
      <strong>How to use these</strong>
      <p>{howToUse}</p>
    </div>
  )}

  {relatedSlugs && relatedSlugs.length > 0 && (
    <div class="related">
      <strong>Related</strong><br />
      {relatedSlugs.map((slug: string) => <a href={hrefFor(slug)}>{slug.replace(/-/g, ' ')}</a>)}
    </div>
  )}
</Layout>
